# ---- Voice (TTS) ----
# "elevenlabs" (default) ya "gemini"
TTS_PROVIDER=elevenlabs

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice library se koi bhi voice ID (Hindi ke liye koi Indian voice chuno)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_multilingual_v2 (best quality) ya eleven_flash_v2_5 (fast)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---- Gemini ---- https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Sentence banane aur "Gemini se poochho" (image check) ke liye
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Gemini TTS (jab TTS_PROVIDER=gemini ho, ya ElevenLabs fail ho)
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
